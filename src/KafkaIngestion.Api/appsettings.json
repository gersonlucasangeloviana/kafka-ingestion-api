{
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "Topic": "benchmark.ids",
    "Partitions": 6,
    "ReplicationFactor": 1,
    "CreateTopicOnStartup": true,
    "EnablePurge": false
  },
  "Ingestion": { "MaxConcurrentRequests": 8192 },
  "Logging": { "LogLevel": { "Default": "Warning", "Microsoft.Hosting.Lifetime": "Information" } },
  "AllowedHosts": "*"
}
